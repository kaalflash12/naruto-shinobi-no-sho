{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "naruto-shinobi-no-sho-online",
  "main": "src/index.js",
  "compatibility_date": "2026-08-20",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "PUBLIC_GAME_URL": "https://kaalflash12.github.io/naruto-shinobi-no-sho/",
    "ALLOWED_ORIGINS": "https://kaalflash12.github.io"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "naruto-shinobi-no-sho-online",
      "migrations_dir": "migrations"
    }
  ],
  "durable_objects": {
    "bindings": [
      {"name": "GAME_ROOMS", "class_name": "GameRoom"}
    ]
  },
  "migrations": [
    {"tag": "v1", "new_sqlite_classes": ["GameRoom"]}
  ],
  "ai": {"binding": "AI"}
}
